# Frontend API URL. Set this in Vercel to your Render API URL, including /api.
VITE_API_URL=https://your-render-service.onrender.com/api

# PostgreSQL Connection String (Supabase pooled connection; configure on Render)
DATABASE_URL=postgresql://postgres.project-ref:password@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require&pgbouncer=true

# Direct database connection string (configure on Render for Prisma migrations)
DIRECT_URL=postgresql://postgres.project-ref:password@db.project-ref.supabase.co:5432/postgres?sslmode=require

# JWT Authentication
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h

# Business Logic Configuration
LOYALTY_POINTS_PER_KES=0.01

# Local Port (used when running api standalone)
PORT=3000

# Vercel frontend URL(s), comma-separated when needed (configure on Render)
ALLOWED_ORIGIN=http://localhost:5173
