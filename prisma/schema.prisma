generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Vercel's Supabase integration provisions these names automatically.
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Role {
  ADMIN
  MANAGER
  BARBER
  SHAMPOO_ASSISTANT
}

enum UserStatus {
  APPROVED
  SUSPENDED
}

enum OrderStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
  OTHER
}

enum InventoryMovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT
}

model User {
  id           String         @id @default(cuid())
  username     String         @unique
  passwordHash String
  role         Role
  status       UserStatus     @default(APPROVED)
  isActive     Boolean        @default(true)
  fullName     String?
  email        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  barber       Barber?
  customers    Customer[]     @relation("ManagerCustomers")
  services     Service[]      @relation("ManagerServices")
  orders       ServiceOrder[] @relation("ManagerOrders")
  transactions Transaction[]  @relation("ManagerTransactions")
  inventoryItems InventoryItem[]
  inventoryMovements InventoryMovement[]

  @@index([role, status, isActive])
}

model Barber {
  id             String         @id @default(cuid())
  userId         String?        @unique
  name           String
  phone          String?
  commissionPct  Decimal        @default(0) @db.Decimal(5,2)
  isActive       Boolean        @default(true)
  user           User?          @relation(fields: [userId], references: [id])
  orders         ServiceOrder[]
  transactions   Transaction[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([isActive, name])
}

model Customer {
  id            String         @id @default(cuid())
  managerId     String
  name          String
  phone         String?
  email         String?
  loyaltyPoints Int            @default(0)
  totalVisits   Int            @default(0)
  totalSpent    Decimal        @default(0) @db.Decimal(12,2)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  manager       User           @relation("ManagerCustomers", fields: [managerId], references: [id])
  orders        ServiceOrder[]
  transactions  Transaction[]
  updatedAt     DateTime       @updatedAt

  @@index([managerId, isActive])
  @@index([phone])
}

model Service {
  id              String         @id @default(cuid())
  managerId       String
  name            String
  price           Decimal        @db.Decimal(12,2)
  commissionPct   Decimal?       @db.Decimal(5,2)
  durationMinutes Int            @default(30)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  manager         User           @relation("ManagerServices", fields: [managerId], references: [id])
  orders          ServiceOrder[]
  transactions    Transaction[]
  updatedAt       DateTime       @updatedAt

  @@unique([managerId, name])
  @@index([managerId, isActive])
}

model ServiceOrder {
  id             String        @id @default(cuid())
  managerId      String
  customerId     String
  serviceId      String
  barberId       String
  servicePrice   Decimal       @db.Decimal(12,2)
  commissionAmt  Decimal       @db.Decimal(12,2)
  paymentMethod  PaymentMethod @default(CASH)
  status         OrderStatus   @default(ASSIGNED)
  notes          String?
  assignedAt     DateTime      @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  manager        User          @relation("ManagerOrders", fields: [managerId], references: [id])
  customer       Customer      @relation(fields: [customerId], references: [id])
  service        Service       @relation(fields: [serviceId], references: [id])
  barber         Barber        @relation(fields: [barberId], references: [id])
  transaction    Transaction?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([managerId, status, createdAt])
  @@index([barberId, status])
  @@index([customerId, createdAt])
}

model Transaction {
  id               String        @id @default(cuid())
  orderId          String        @unique
  managerId        String
  customerId       String
  barberId         String
  serviceId        String
  amount           Decimal       @db.Decimal(12,2)
  commissionAmount Decimal       @db.Decimal(12,2)
  paymentMethod    PaymentMethod
  reference        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  order            ServiceOrder  @relation(fields: [orderId], references: [id])
  manager          User          @relation("ManagerTransactions", fields: [managerId], references: [id])
  customer         Customer      @relation(fields: [customerId], references: [id])
  barber           Barber        @relation(fields: [barberId], references: [id])
  service          Service       @relation(fields: [serviceId], references: [id])

  @@index([managerId, createdAt])
  @@index([barberId, createdAt])
}

model InventoryItem {
  id           String              @id @default(cuid())
  managerId    String
  name         String
  sku          String?
  unit         String              @default("unit")
  quantity     Decimal             @default(0) @db.Decimal(12,2)
  reorderLevel Decimal             @default(0) @db.Decimal(12,2)
  costPrice    Decimal?            @db.Decimal(12,2)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  manager      User                @relation(fields: [managerId], references: [id])
  movements    InventoryMovement[]

  @@unique([managerId, name])
  @@index([managerId, isActive])
}

model InventoryMovement {
  id          String                @id @default(cuid())
  inventoryId String
  managerId   String
  type        InventoryMovementType
  quantity    Decimal               @db.Decimal(12,2)
  reason      String?
  createdAt   DateTime              @default(now())
  inventory   InventoryItem         @relation(fields: [inventoryId], references: [id])
  manager     User                  @relation(fields: [managerId], references: [id])

  @@index([inventoryId, createdAt])
  @@index([managerId, createdAt])
}
